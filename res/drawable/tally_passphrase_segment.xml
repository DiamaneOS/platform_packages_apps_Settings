<!-- One choice of the segmented selector: filled with the accent when it is the chosen one,
     a little inside the outline of the group. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:inset="@dimen/tally_passphrase_segment_inset">
            <shape android:shape="rectangle">
                <solid android:color="@color/tally_passphrase_segment_fill" />
                <corners android:radius="@dimen/tally_radius_m" />
            </shape>
        </inset>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
