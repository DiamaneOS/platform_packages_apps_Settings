<!-- The filled button of tally_stacked_dialog_buttons.xml: the filled dialog button of the
     settings library, in a ripple. The library's shape alone has no state for focus, so a
     focused button got the system's highlight, a lighter rectangle over its whole view,
     wider and taller than the button. Here the highlight has the button's shape. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:drawable="@drawable/settingslib_expressive_button_background_filled" />
</ripple>
