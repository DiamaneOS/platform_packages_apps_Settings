<!-- The first row under a section title, with more rows below: only the card's side edges
     show; its top and bottom edges lie outside the view. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item
        android:left="@dimen/tally_homepage_card_margin"
        android:right="@dimen/tally_homepage_card_margin"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tally_surface"/>
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_outline_variant"/>
        </shape>
    </item>
    <!-- The ripple's mask: the row's own part of the card, so a press stays inside it. It is
         an inset, not a layer with insets: a layer's insets do not count, and an opaque mask
         only clips the ripple to the whole row, side margins included. -->
    <item android:id="@android:id/mask">
        <inset
            android:insetLeft="@dimen/tally_homepage_card_margin"
            android:insetRight="@dimen/tally_homepage_card_margin">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white"/>
            </shape>
        </inset>
    </item>
</ripple>
