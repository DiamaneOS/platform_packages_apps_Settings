<!-- The only row under a section title: rounded bottom corners, side and bottom edges; its top
     edge lies outside the view, so no line runs between the title and the row. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item
        android:left="@dimen/tally_homepage_card_margin"
        android:right="@dimen/tally_homepage_card_margin"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tally_surface"/>
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_outline_variant"/>
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/tally_radius_m"
                android:bottomRightRadius="@dimen/tally_radius_m"/>
        </shape>
    </item>
</ripple>
