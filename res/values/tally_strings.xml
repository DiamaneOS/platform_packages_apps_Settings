<!-- DiamaneOS's own Settings text for About phone. English only: where stock Android has
     a translated string for the same message, the Tally code uses that one instead (the homepage
     section titles are stock's: wireless_networks_settings_title, device_dashboard_title,
     privacy_header, header_category_system). -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- About phone: the line under the DiamaneOS mark, saying what the system is based on and
         who does not make it. "DiamaneOS", "GrapheneOS" and "Fairphone" are names.
         [CHAR LIMIT=NONE] -->
    <string name="tally_about_based_on">DiamaneOS is based on GrapheneOS. It is not made or endorsed by Fairphone.</string>
    <!-- About phone > Android version: label of the vendor security patch level, the date of
         the last security update of the device maker's vendor software, shown under "Android
         security update" in the same date format. [CHAR LIMIT=60] -->
    <string name="tally_vendor_security_patch">Vendor security update</string>
    <!-- What the vendor security update row reports, for the preferences API. Not shown. -->
    <string name="tally_vendor_security_patch_purpose" translatable="false">The date of the last vendor security update</string>
    <!-- About phone > Android version: label of the Fairphone firmware release the phone runs (boot
         chain, modem and signal processor firmware), shown under "Vendor security update" as a
         release number such as 16.111.0. "Fairphone" is a name. [CHAR LIMIT=60] -->
    <string name="tally_firmware_release">Fairphone firmware</string>
    <!-- About phone > Android version > Fairphone firmware: shown instead of a release number when
         the firmware parts come from different Fairphone releases. [CHAR LIMIT=60] -->
    <string name="tally_firmware_release_mixed">Mixed releases</string>
    <!-- What the Fairphone firmware row reports, for the preferences API. Not shown. -->
    <string name="tally_firmware_release_purpose" translatable="false">The installed Fairphone firmware release</string>
    <!-- Link text in the footers of Secure app spawning, App info > Hardened memory allocator and
         Auto reboot: opens GrapheneOS's own documentation of the feature, which DiamaneOS
         inherits. "GrapheneOS" is a name. [CHAR LIMIT=40] -->
    <string name="tally_grapheneos_documentation">GrapheneOS documentation</string>
    <!-- Display > Maximum refresh rate: replaces the Smooth display switch. [CHAR LIMIT=40] -->
    <string name="tally_refresh_rate_title">Maximum refresh rate</string>
    <!-- What the Maximum refresh rate setting controls, for the preferences API. Not shown. -->
    <string name="tally_refresh_rate_purpose" translatable="false">The highest refresh rate the screen may use</string>
    <!-- Summary of Display > Maximum refresh rate, for example "Up to 120 Hz". [CHAR LIMIT=40] -->
    <string name="tally_refresh_rate_summary">Up to <xliff:g id="refresh_rate" example="120">%1$d</xliff:g> Hz</string>
    <!-- Text above the choices in Display > Maximum refresh rate. -->
    <string name="tally_refresh_rate_intro">The screen lowers its refresh rate when nothing moves, to save battery. A higher maximum makes scrolling and animations smoother and uses more battery.</string>
    <!-- Security & privacy > Exploit protection > Hardware video decoding: entry and page title. [CHAR LIMIT=40] -->
    <string name="tally_hw_video_decoding_title">Hardware video decoding</string>
    <!-- Hardware video decoding page, first choice: only copy-protected video (films and series from streaming services) uses the hardware decoder. Also the entry summary. [CHAR LIMIT=40] -->
    <string name="tally_hw_video_decoding_protected_title">Protected video only (default)</string>
    <!-- Hardware video decoding page: what the first choice does. -->
    <string name="tally_hw_video_decoding_protected_summary">Only video that an app plays with copy protection, such as films from streaming services, uses the hardware decoder. All other video stays in the sandboxed software decoder.</string>
    <!-- Hardware video decoding page, second choice: every video uses the hardware decoder. Also the entry summary. [CHAR LIMIT=40] -->
    <string name="tally_hw_video_decoding_all_title">All video</string>
    <!-- Hardware video decoding page: what the second choice does. -->
    <string name="tally_hw_video_decoding_all_summary">Every app decodes video with the hardware decoder, which saves battery and plays high-resolution video more smoothly.</string>
    <!-- Hardware video decoding page, third choice: no video uses the hardware decoder. Also the entry summary. [CHAR LIMIT=40] -->
    <string name="tally_hw_video_decoding_never_title">Never</string>
    <!-- Hardware video decoding page: what the third choice does. -->
    <string name="tally_hw_video_decoding_never_summary">No video uses the hardware decoder, and copy-protected video gets weaker protection, so some streaming services play it in lower quality or not at all.</string>
    <!-- Hardware video decoding entry summary while a change waits for a restart, for example "After restart: All video". [CHAR LIMIT=60] -->
    <string name="tally_hw_video_decoding_summary_after_restart">After restart: <xliff:g id="choice" example="All video">%1$s</xliff:g></string>
    <!-- Hardware video decoding page: what the choice trades. -->
    <string name="tally_hw_video_decoding_footer">The hardware decoder is the chip maker\'s closed code, with its own driver and firmware, and a malicious video that reaches it can attack them. The software decoder runs in a sandbox. It uses more battery and can stutter at high resolutions. An app can ask for copy-protected playback for its own video, so the default keeps ordinary video away from the hardware decoder, not every app. A change takes effect after you restart the phone.</string>
    <!-- Wi-Fi hotspot, connected device: IP address, then MAC address. -->
    <string name="tally_hotspot_client_address" translatable="false"><xliff:g id="ip_address" example="192.168.43.25">%1$s</xliff:g> \u00b7 <xliff:g id="mac_address" example="a2:11:22:33:44:55">%2$s</xliff:g></string>
    <!-- Wi-Fi hotspot, note under the list of connected devices. -->
    <string name="tally_hotspot_clients_note">A device picks its own name, so a name can be false. Most devices show a random MAC address, and some change it each time they connect.</string>
</resources>
