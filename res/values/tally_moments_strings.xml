<!-- The Moments switch page (System > Gestures > Moments switch), on phones with a Moments
     switch, a slider on the side of the phone. English only for now. -->
<resources>
    <!-- Title of the Moments switch page and its entry in Gestures. "Moments" is the feature's
         name. [CHAR LIMIT=40] -->
    <string name="tally_moments_title">Moments switch</string>
    <!-- Text at the top of the page. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_intro">Choose what the switch on the side of the phone does when you slide it on. Sliding it back changes back what it changed.</string>
    <!-- Summary in Gestures before the user chose an action. [CHAR LIMIT=60] -->
    <string name="tally_moments_not_set">Not set up</string>
    <!-- Heading over the choice of action. [CHAR LIMIT=60] -->
    <string name="tally_moments_action_header">When the switch is on</string>

    <!-- Action: Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_moments">Moments</string>
    <!-- What Moments does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_moments_summary">Do Not Disturb with the people and apps you allow, Home with only the apps you choose, and the apps you choose paused</string>
    <!-- Action: camera and microphone access off. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_sensors">Camera and microphone off</string>
    <!-- What it does. Must say plainly that this is a software setting, not a hardware cut-off.
         [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_sensors_summary">Turns off camera and microphone access, as the quick settings do. This is a software setting, not a hardware cut-off.</string>
    <!-- Action: silent mode. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_silent">Silent mode</string>
    <!-- What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_silent_summary">Silences calls and notifications</string>
    <!-- Action: airplane mode, Lockdown or both. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_offline">Airplane mode or Lockdown</string>
    <!-- What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_offline_summary">Turns on airplane mode, locks the phone down, or both</string>
    <!-- Action: nothing. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_nothing">Nothing</string>
    <!-- What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_nothing_summary">The switch does nothing</string>

    <!-- Heading over Moments' options. [CHAR LIMIT=60] -->
    <string name="tally_moments_options_header">Moments</string>
    <!-- Opens the list of apps Home shows during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_home_apps">Apps on Home</string>
    <!-- Summary when no apps are chosen for Home. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_home_apps_none">None chosen: Home stays as it is</string>
    <!-- Opens the list of apps paused during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_paused_apps">Paused apps</string>
    <!-- Summary when no apps are paused. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_paused_apps_none">None</string>
    <!-- Summary with the chosen apps' count. [CHAR LIMIT=NONE] -->
    <plurals name="tally_moments_apps_count">
        <item quantity="one"><xliff:g id="count" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%d</xliff:g> app</item>
        <item quantity="other"><xliff:g id="count" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%d</xliff:g> apps</item>
    </plurals>
    <!-- Switch: grey screen during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_greyscale">Grey screen</string>
    <!-- Its summary. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_greyscale_summary">Shows the screen in shades of grey</string>

    <!-- Heading over the airplane mode and Lockdown options. [CHAR LIMIT=60] -->
    <string name="tally_moments_offline_header">Airplane mode or Lockdown</string>
    <!-- Switch: airplane mode. [CHAR LIMIT=40] -->
    <string name="tally_moments_offline_airplane">Airplane mode</string>
    <!-- Switch: Lockdown. [CHAR LIMIT=40] -->
    <string name="tally_moments_offline_lockdown">Lockdown</string>
    <!-- Its summary. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_offline_lockdown_summary">Locks the phone and turns off fingerprint and face unlock until you enter your PIN, pattern or password. Sliding the switch back does not end it.</string>

    <!-- Lockdown's summary when the phone has no PIN, pattern or password. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_offline_lockdown_needs_lock">Needs a PIN, pattern or password</string>

    <!-- Footer. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_footer">Sliding the switch on works on the lock screen too. Sliding it back turns camera and microphone access, airplane mode and paused apps back only after you unlock. Settings you changed yourself meanwhile stay as you set them.</string>

    <!-- Title of the app list for Home during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_home_apps_title">Apps on Home during Moments</string>
    <!-- Title of the app list paused during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_paused_apps_title">Paused during Moments</string>
    <!-- Intro of the paused app list. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_paused_apps_intro">Paused apps can\'t open or send notifications while Moments is on. Some apps, such as Phone, can\'t be paused.</string>
</resources>
