<!-- The Moments switch page (System > Gestures > Moments switch), on phones with a Moments
     switch, a slider on the side of the phone. Translated into German, French, Spanish and Italian,
     the other languages English only. en-rGB, en-rAU and en-rIN copy the texts that name airplane
     mode with "aeroplane", as Settings' airplane_mode does there. -->
<resources>
    <!-- Title of the Moments switch page and its entry in Gestures. "Moments" is the feature's
         name. [CHAR LIMIT=40] -->
    <string name="tally_moments_title">Moments switch</string>
    <!-- Text at the top of the page. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_intro">Choose what the switch on the side of the phone does when you slide it on. Sliding it back changes back what it changed.</string>
    <!-- Heading over the choice of action. [CHAR LIMIT=60] -->
    <string name="tally_moments_action_header">When the switch is on</string>

    <!-- Action: Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_moments">Moments</string>
    <!-- What Moments does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_moments_summary">Do Not Disturb with the people and apps you allow, Home with only the apps you choose, and the apps you choose paused</string>
    <!-- Action: camera and microphone access off. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_sensors">Camera and microphone off</string>
    <!-- What it does. Must say plainly that this is a software setting, not a hardware cut-off.
         [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_sensors_summary">Turns off camera and microphone access, as the quick settings do. This is a software setting, not a hardware cut-off.</string>
    <!-- The same action's summary on phones whose kernel also turns the microphones off.
         [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_sensors_summary_kernel">Turns off camera and microphone access, as the quick settings do. The kernel also blocks the built-in cameras and microphones.</string>
    <!-- Action: silent mode. Stock's translated name. -->
    <string name="tally_moments_action_silent" translatable="false">@*android:string/silent_mode</string>
    <!-- What it does. The volume panel's translated note. -->
    <string name="tally_moments_action_silent_summary" translatable="false">@*android:string/volume_dialog_ringer_guidance_silent</string>
    <!-- Action: airplane mode. What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_airplane_summary">Turns on airplane mode</string>
    <!-- Action: Lockdown. What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_lockdown_summary">Locks the phone. While the switch is on, fingerprint and face unlock stay off, so every unlock needs your PIN, pattern or password.</string>
    <!-- Lockdown's summary when the phone has no PIN, pattern or password. The choice is
         disabled. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_lockdown_needs_lock">Needs a PIN, pattern or password</string>
    <!-- Action: nothing. [CHAR LIMIT=40] -->
    <string name="tally_moments_action_nothing">Nothing</string>
    <!-- What it does. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_action_nothing_summary">The switch does nothing</string>

    <!-- Heading over the notes on the kernel's microphone block. [CHAR LIMIT=60] -->
    <string name="tally_moments_kernel_header">Block in the kernel</string>
    <!-- Title of the note on the kernel's microphone block. [CHAR LIMIT=60] -->
    <string name="tally_moments_kernel_title">Built-in microphones</string>
    <!-- The same title when the kernel also blocks the cameras. [CHAR LIMIT=60] -->
    <string name="tally_moments_kernel_title_camera">Built-in cameras and microphones</string>
    <!-- The note when the kernel blocks the microphones in this boot and the action is still
         chosen. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_on">While the switch is down, the kernel mutes the built-in microphones and turns off their power. No app or Android service can turn them back on. Only the switch can, at once, also on the lock screen. Another choice reaches the kernel only after a restart. Android\'s block changes at once.</string>
    <!-- The note when the action is chosen but the kernel does not block the camera and microphone in
         this boot (it did not take the choice at once and learns it at the next start). Until
         then only Android blocks them.
         Keep this wording. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_after_restart">The kernel does not block the camera and microphone yet. Restart your phone so the switch also locks them off below Android.</string>
    <!-- The note when another action was chosen but the kernel still blocks the microphones
         until the next start. Keep this wording. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_until_restart">The microphone stays locked off with the switch down until you restart.</string>
    <!-- The same with the cameras blocked too. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_until_restart_camera">The camera and microphone stay locked off with the switch down until you restart.</string>
    <!-- The note when the kernel blocks the cameras and microphones in this boot and the action
         is still chosen. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_on_camera">While the switch is down, the kernel holds the cameras on a test image and mutes the built-in microphones, turning off their power. No app or Android service can undo this. Only the switch can, at once, also on the lock screen. Another choice reaches the kernel only after a restart. Android\'s block changes at once.</string>
    <!-- Emergency calls while the kernel blocks the microphones. Keep this wording.
         [CHAR LIMIT=NONE] -->
    <string name="tally_moments_kernel_emergency">While the switch is down, emergency calls have no microphone.</string>

    <!-- Switch under "Camera and microphone off": a short note when an app tries a camera or
         microphone the switch blocks. Keep this wording. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_sensor_note">Show a note when an app tries to use a blocked camera or microphone</string>
    <!-- Its summary. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_sensor_note_summary">Either way, apps can\'t use the camera and get silence from the microphone, without an Unblock prompt. Off: nothing shows.</string>

    <!-- Heading over Moments' options. [CHAR LIMIT=60] -->
    <string name="tally_moments_options_header">Moments</string>
    <!-- Opens the list of apps Home shows during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_home_apps">Apps on Home</string>
    <!-- Summary when no apps are chosen for Home. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_home_apps_none">None chosen: Home stays as it is</string>
    <!-- Opens the list of apps paused during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_paused_apps">Paused apps</string>
    <!-- Summary when no apps are paused. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_paused_apps_none">None</string>
    <!-- Summary with the chosen apps' count. [CHAR LIMIT=NONE] -->
    <plurals name="tally_moments_apps_count">
        <item quantity="one"><xliff:g id="count" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%d</xliff:g> app</item>
        <item quantity="other"><xliff:g id="count" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%d</xliff:g> apps</item>
    </plurals>

    <!-- Footer. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_footer">Sliding the switch on works on the lock screen too. Sliding it back turns airplane mode and paused apps back only after you unlock. Camera and microphone access comes back at once if the kernel blocked it, and otherwise after you unlock. Settings you changed yourself meanwhile stay as you set them.</string>

    <!-- Title of the app list for Home during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_home_apps_title">Apps on Home during Moments</string>
    <!-- Title of the app list paused during Moments. [CHAR LIMIT=40] -->
    <string name="tally_moments_paused_apps_title">Paused during Moments</string>
    <!-- Intro of the paused app list. [CHAR LIMIT=NONE] -->
    <string name="tally_moments_paused_apps_intro">Paused apps can\'t open or send notifications while Moments is on. Some apps, such as Phone, can\'t be paused.</string>
</resources>
