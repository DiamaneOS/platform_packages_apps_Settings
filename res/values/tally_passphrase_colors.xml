<!-- Colours of the verdict on a typed passphrase. Not design tokens: there is no token for
     "caution" or "good" yet. Weaker is a calm amber, not the error colour, because a weaker
     password is allowed. Night values are in values-night. -->
<resources>
    <!-- While nothing is typed: the secondary text colour. -->
    <color name="tally_passphrase_verdict_neutral">@color/tally_ink_muted</color>
    <color name="tally_passphrase_verdict_weaker">#8A5A00</color>
    <color name="tally_passphrase_verdict_strong">#2F7D41</color>
</resources>
