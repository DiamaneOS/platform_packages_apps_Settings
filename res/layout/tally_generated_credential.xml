<!-- The part of the password screen for a passphrase or PIN the phone generated. It is added
     above the entry field. Top to bottom: the secret (hidden until Show), the row that changes
     it, one strength line, two lines of advice. The whole of it fits a phone screen at the
     default font size without scrolling; the screen's own scroll view takes over beyond that.
     The secret is only ever in the two tally_generated_secret views, which keep no state,
     cannot be selected and stay out of autofill and content capture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tally_generated_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAutofill="noExcludeDescendants"
    android:importantForContentCapture="noExcludeDescendants">

    <LinearLayout
        android:id="@+id/tally_generated_show_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- As tall as four lines of words, so that nothing below moves when the secret is
             shown or hidden. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="112dp">

            <TextView
                android:id="@+id/tally_generated_placeholder"
                style="@style/SudDescription.Glif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

            <LinearLayout
                android:id="@+id/tally_generated_secret_columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tally_generated_secret"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textIsSelectable="false"
                    android:longClickable="false"
                    android:saveEnabled="false" />

                <TextView
                    android:id="@+id/tally_generated_secret_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textIsSelectable="false"
                    android:longClickable="false"
                    android:saveEnabled="false" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/tally_generated_reveal"
            style="@style/SudGlifButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tally_generated_show" />

        <!-- Fewer words, the count, more words; at the end, a new phrase. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tally_generated_fewer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:textSize="20sp"
                android:text="@string/tally_generated_minus"
                android:contentDescription="@string/tally_generated_fewer_words" />

            <TextView
                android:id="@+id/tally_generated_words_count"
                style="@style/SudDescription.Glif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/tally_generated_more"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:textSize="20sp"
                android:text="@string/tally_generated_plus"
                android:contentDescription="@string/tally_generated_more_words" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/tally_generated_another"
                style="@style/SudGlifButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tally_generated_another" />
        </LinearLayout>

        <!-- One line; a tap opens how it is estimated. -->
        <TextView
            android:id="@+id/tally_generated_strength"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_s"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:drawableEnd="@drawable/ic_info_outline_24dp"
            android:drawablePadding="@dimen/tally_space_s" />

        <TextView
            android:id="@+id/tally_generated_advice"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_s" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tally_generated_type_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tally_generated_hint"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tally_generated_show_again"
            style="@style/SudGlifButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tally_generated_show_again" />
    </LinearLayout>
</LinearLayout>
