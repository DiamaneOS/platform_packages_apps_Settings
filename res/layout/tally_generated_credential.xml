<!-- The part of the password screen that shows a passphrase or PIN the phone generated. It is
     added above the entry field. The secret is only ever in tally_generated_secret, which keeps
     no state, cannot be selected and stays out of autofill and content capture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tally_generated_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAutofill="noExcludeDescendants"
    android:importantForContentCapture="noExcludeDescendants">

    <LinearLayout
        android:id="@+id/tally_generated_show_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tally_generated_advice"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tally_generated_words_label"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_l"
            android:labelFor="@+id/tally_generated_words"
            android:text="@string/tally_generated_words_label" />

        <RadioGroup
            android:id="@+id/tally_generated_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tally_generated_words_5"
                style="@style/SudRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/tally_generated_words_6"
                style="@style/SudRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/tally_generated_words_7"
                style="@style/SudRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/tally_generated_words_8"
                style="@style/SudRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tally_generated_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_l"
            android:paddingTop="@dimen/tally_space_m"
            android:paddingBottom="@dimen/tally_space_m"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="false"
            android:longClickable="false"
            android:saveEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tally_generated_reveal"
                style="@style/SudGlifButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tally_generated_show" />

            <Button
                android:id="@+id/tally_generated_another"
                style="@style/SudGlifButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tally_space_s"
                android:text="@string/tally_generated_another" />
        </LinearLayout>

        <TextView
            android:id="@+id/tally_generated_strength"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_space_l" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tally_generated_type_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tally_generated_hint"
            style="@style/SudDescription.Glif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tally_generated_show_again"
            style="@style/SudGlifButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tally_generated_show_again" />
    </LinearLayout>
</LinearLayout>
