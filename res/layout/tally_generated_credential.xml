<!-- The part of the password screen for a passphrase or PIN the phone generated. It is added
     above the entry field. Top to bottom: a card with the secret and its Show control; one row
     with the number of words and "New phrase"; one strength row; two paragraphs of advice.
     Sizes, colours and styles are in res/values/tally_passphrase_styles.xml.
     The secret is only ever in the two tally_generated_words views, which keep no state,
     cannot be selected and stay out of autofill and content capture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tally_generated_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAutofill="noExcludeDescendants"
    android:importantForContentCapture="noExcludeDescendants">

    <LinearLayout
        android:id="@+id/tally_generated_show_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The card. Hidden and shown it has the same grid, so it keeps its size. -->
        <LinearLayout
            android:id="@+id/tally_generated_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/tally_passphrase_card"
            android:paddingStart="@dimen/tally_passphrase_card_padding"
            android:paddingEnd="@dimen/tally_passphrase_card_padding"
            android:paddingTop="@dimen/tally_passphrase_card_padding"
            android:paddingBottom="@dimen/tally_passphrase_gap_small">

            <!-- Number, word, number, word: two columns of numbered words. A PIN uses the
                 first word view alone. -->
            <LinearLayout
                android:id="@+id/tally_generated_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tally_generated_numbers"
                    style="@style/TallyPassphrase.Secret.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tally_passphrase_number_gap"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tally_generated_words"
                    style="@style/TallyPassphrase.Secret"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tally_generated_numbers_right"
                    style="@style/TallyPassphrase.Secret.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tally_passphrase_number_gap"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tally_generated_words_right"
                    style="@style/TallyPassphrase.Secret"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- In place of the grid while there is nothing to show yet, or ever. -->
            <TextView
                android:id="@+id/tally_generated_placeholder"
                style="@style/TallyPassphrase.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tally_generated_reveal"
                style="@style/TallyPassphrase.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tally_passphrase_gap_small"
                android:drawableStart="@drawable/ic_visibility_18dp"
                android:text="@string/tally_generated_show" />
        </LinearLayout>

        <!-- One row, centred on one line: "Words", the choice of 5 to 8, and a new phrase. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tally_passphrase_control_height"
            android:layout_marginTop="@dimen/tally_passphrase_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tally_generated_words_caption"
                style="@style/TallyPassphrase.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/tally_passphrase_gap_small"
                android:labelFor="@+id/tally_generated_words_choice"
                android:text="@string/tally_generated_words_caption" />

            <RadioGroup
                android:id="@+id/tally_generated_words_choice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tally_passphrase_outline"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/tally_generated_words_5"
                    style="@style/TallyPassphrase.Segment" />

                <RadioButton
                    android:id="@+id/tally_generated_words_6"
                    style="@style/TallyPassphrase.Segment" />

                <RadioButton
                    android:id="@+id/tally_generated_words_7"
                    style="@style/TallyPassphrase.Segment" />

                <RadioButton
                    android:id="@+id/tally_generated_words_8"
                    style="@style/TallyPassphrase.Segment" />
            </RadioGroup>

            <!-- Keeps the button at the end when there is no choice of words (a PIN). -->
            <Space
                android:id="@+id/tally_generated_row_filler"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tally_generated_another"
                style="@style/TallyPassphrase.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/tally_passphrase_gap"
                android:drawableStart="@drawable/ic_sync"
                android:text="@string/tally_generated_another" />
        </LinearLayout>

        <!-- One row; a tap opens how the time is estimated. -->
        <TextView
            android:id="@+id/tally_generated_strength"
            style="@style/TallyPassphrase.Link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_passphrase_gap_small"
            android:drawableStart="@drawable/ic_info_outline_24dp"
            android:drawableTint="@color/tally_ink_muted"
            android:textColor="@color/tally_ink_muted"
            android:maxLines="2" />

        <TextView
            style="@style/TallyPassphrase.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_passphrase_gap_small"
            android:text="@string/tally_generated_advice" />

        <TextView
            style="@style/TallyPassphrase.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tally_passphrase_gap_small"
            android:text="@string/tally_lock_no_recovery" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tally_generated_type_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tally_generated_hint"
            style="@style/TallyPassphrase.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tally_generated_show_again"
            style="@style/TallyPassphrase.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_visibility_18dp"
            android:text="@string/tally_generated_show_again" />
    </LinearLayout>
</LinearLayout>
