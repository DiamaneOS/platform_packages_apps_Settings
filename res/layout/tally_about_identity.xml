<!-- About phone's head (the prototype's About page): DiamaneOS's lockup, 36 dp high with two
     bonds' width of clear space above and below it, and one line saying what DiamaneOS is based
     on. The line names DiamaneOS, so the lockup is hidden from screen readers (the brand's
     empty-alt rule). The mark sits on its own here, never next to a state lamp. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/tally_space_xxl"
    android:paddingEnd="@dimen/tally_space_xxl"
    android:paddingTop="@dimen/tally_space_s"
    android:paddingBottom="@dimen/tally_space_xl">

    <ImageView
        android:id="@+id/tally_about_lockup"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/tally_space_xl"
        android:layout_marginBottom="@dimen/tally_space_xl"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/tally_about_lockup"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/tally_about_based_on"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Tally.Body"
        android:lineHeight="@dimen/tally_type_body_line_height"
        android:textColor="@color/tally_ink_muted"
        android:text="@string/tally_about_based_on"/>
</LinearLayout>
