<!-- A Tally homepage section title (the prototype's .sec-h): small capitals in the muted colour
     at the top of its card, which TallyHomepageAdapter draws behind it. A plain colour, not a
     state list: a category is never enabled, and its title must not look disabled. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/tally_homepage_row_padding_horizontal"
    android:paddingEnd="@dimen/tally_homepage_row_padding_horizontal"
    android:paddingTop="@dimen/tally_space_m"
    android:paddingBottom="@dimen/tally_space_xs"
    android:textAlignment="viewStart"
    android:textAppearance="@style/TextAppearance.Tally.Section"
    android:lineHeight="@dimen/tally_type_section_line_height"
    android:textColor="@color/tally_ink_muted"/>
