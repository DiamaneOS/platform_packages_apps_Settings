<!-- The two buttons of the warning for a weaker lock, one under the other at full width: the
     recommended way out filled, the agreement as a plain text button. After
     dialog_custom_body_audio_sharing.xml, which stacks the same dialog button styles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/tally_passphrase_gap_small"
    android:paddingBottom="?android:attr/dialogPreferredPadding"
    android:paddingStart="?android:attr/dialogPreferredPadding"
    android:paddingEnd="?android:attr/dialogPreferredPadding">

    <Button
        android:id="@+id/tally_weaker_risk_decline"
        style="@style/Widget.SettingsLib.DialogButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp" />

    <Button
        android:id="@+id/tally_weaker_risk_accept"
        style="@style/Widget.SettingsLib.DialogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tally_passphrase_gap_small" />
</LinearLayout>
