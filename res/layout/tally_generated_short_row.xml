<!-- One word of the short-list passphrase on the card: its number, the letters that are typed
     and the rest of the word. Read out as one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:screenReaderFocusable="true">

    <TextView
        android:id="@+id/tally_short_number"
        style="@style/TallyPassphrase.Secret.Number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/tally_passphrase_number_gap"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tally_short_prefix"
        style="@style/TallyPassphrase.Secret.Prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tally_short_rest"
        style="@style/TallyPassphrase.Secret.Rest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
